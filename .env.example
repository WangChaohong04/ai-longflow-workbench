# LongFlow 环境变量示例
# 复制本文件为 .env 并按需填写。.env 已在 .gitignore 中，不会被提交。
# 密钥只从环境变量读取，绝不写入数据库、日志或 API 响应（redaction 兜底脱敏）。

# --- LLM 网关 ---
# 驱动由 config/longflow.yaml 的 llm.driver 决定：
#   local              —— 默认。规则驱动，离线可跑，无需以下三项；
#   openai_compatible  —— httpx 调用 {LLM_BASE_URL}/chat/completions，需要配置三项。

# API Key：openai_compatible 驱动必填；local 驱动留空即可。
LLM_API_KEY=

# OpenAI 兼容端点（可指向官方、自建网关或任何兼容服务）。
LLM_BASE_URL=https://api.openai.com/v1

# 模型名称（由所用端点支持的模型决定）。
LLM_MODEL=gpt-4o-mini

# --- 运行时 ---
# SQLite 数据库路径（WAL 模式）。serve 启动时若库/表不存在会自动幂等创建。
LONGFLOW_DB=data/longflow.db

# --- 地图插件（工作台"地理分析"中的真实地图/路线/跳转）---
# 高德 JS API Key（Web 端 Key。浏览器加载 JS SDK 必需，属公开值——务必在高德后台
# 限制域名/Referer）。不配置时地理分析回退内联 SVG 离线示意图，Haversine 分析不受影响。
AMAP_JS_KEY=

# 高德 Web 服务 Key（服务端调用 Web Service API 用；仅服务器持有，绝不下发浏览器）。
AMAP_WEB_KEY=

# 高德安全密钥 securityJsCode（JS API 2.0 需要）。
# Demo 采用 securityJsCode 客户端方式：该值会随 /api/config 下发，在加载 SDK 前设置
# window._AMapSecurityConfig；生产环境建议改用 serviceHost 代理（见 README）。
# 不写死代码/仓库、不打印日志；.env 不进 Git。
AMAP_SECURITY_CODE=

# 公交路线(transit/Transfer)默认城市，默认北京。
AMAP_CITY=北京
